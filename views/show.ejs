<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i><%= student.name %></h5>
        <span class="badge bg-white text-dark"><%= student.rollNumber %></span>
      </div>
      <div class="card-body">
        <table class="table table-borderless mb-0">
          <tr><th width="40%">Email</th><td><%= student.email %></td></tr>
          <tr><th>Course</th><td><%= student.course %></td></tr>
          <tr><th>Phone</th><td><%= student.phone %></td></tr>
          <tr>
            <th>Marks</th>
            <td>
              <% if (student.marks !== null && student.marks !== undefined) { %>
                <span class="badge <%= student.marks >= 40 ? 'bg-success' : 'bg-danger' %> fs-6">
                  <%= student.marks %> / 100
                </span>
              <% } else { %>
                <span class="text-muted">Not entered</span>
              <% } %>
            </td>
          </tr>
          <tr><th>Address</th><td><%= student.address %></td></tr>
          <tr><th>City</th><td><%= student.city %></td></tr>
          <tr><th>State</th><td><%= student.state %></td></tr>
          <tr><th>Enrollment Date</th><td><%= new Date(student.enrollmentDate).toLocaleDateString('en-IN') %></td></tr>
          <tr><th>Registered On</th><td><%= new Date(student.createdAt).toLocaleString('en-IN') %></td></tr>
        </table>
      </div>
      <div class="card-footer d-flex gap-2">
        <a href="/students/<%= student._id %>/edit" class="btn btn-warning btn-sm">
          <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form action="/students/<%= student._id %>?_method=DELETE" method="POST"
              onsubmit="return confirm('Delete <%= student.name %>?')">
          <button class="btn btn-danger btn-sm" type="submit">
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        </form>
        <a href="/students" class="btn btn-secondary btn-sm ms-auto">
          <i class="bi bi-arrow-left me-1"></i>Back
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
