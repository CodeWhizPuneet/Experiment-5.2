<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6 text-center">
    <div class="card border-danger shadow-sm">
      <div class="card-body py-5">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
        <h3 class="mt-3 text-danger"><%= title %></h3>
        <p class="text-muted"><%= message %></p>
        <% if (error && error.stack && process && process.env && process.env.NODE_ENV === 'development') { %>
          <pre class="text-start bg-light p-3 rounded small"><%= error.stack %></pre>
        <% } %>
        <a href="/students" class="btn btn-primary mt-2">
          <i class="bi bi-house me-1"></i>Go Home
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
